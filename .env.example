# Copy to .env for local development. Never commit the real .env.

# --- Web app -----------------------------------------------------------------
SECRET_KEY=change-me   # production: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql://user:password@localhost:5432/nosifit
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/nosifit_test

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email: Brevo HTTP API in production (SMTP is blocked on Railway), Gmail SMTP locally.
# MAIL_FROM must be a sender verified in Brevo (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=
# SENDGRID_API_KEY=               # alternative to Brevo (paid after a 60-day trial)
MAIL_FROM=NosiFit <your.address@gmail.com>
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional overrides
# APP_ENV=production              # set automatically on Railway (RAILWAY_ENVIRONMENT)
# SESSION_COOKIE_SECURE=true
# PREMIUM_SELF_ACTIVATION=true    # local only: /premium/activate grants premium (off by default)
# PUBLIC_BASE_URL=https://nosifit.example  # links in emails; on Railway defaults to RAILWAY_PUBLIC_DOMAIN
# TZ=Europe/Kyiv                  # so "today" on the server is the users' day
# Redis for rate limits (login, password reset, email codes), shared by all
# gunicorn workers. REQUIRED in production: the app refuses to start without it.
# Locally it may stay empty (per-process counters), or run a throwaway Redis:
#   docker run --rm -p 6379:6379 redis:7-alpine
# RATELIMIT_REDIS_URL=redis://localhost:6379/0
# TEST_REDIS_URL=redis://localhost:6379/15   # tests flush this database
# TRUSTED_ORIGINS=https://a.example,https://b.example  # extra origins allowed to POST

# --- Telegram sign-in (web + bot) -------------------------------------------------
# The SAME random value on the web and bot services; the bot signs its
# /api/telegram/* requests with it. At least 32 characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Unset on the web service -> Telegram sign-in is switched off.
TELEGRAM_BOT_API_SECRET=
# Web only, optional: bot username without "@" for the "Connect Telegram" button.
# TELEGRAM_BOT_USERNAME=NosiFitBot
# Web only, optional: lifetime of one-time link URLs in seconds (60-1800).
# TELEGRAM_LINK_TOKEN_TTL=600

# --- Telegram bot ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
NOSI_FIT_BASE_URL=http://localhost:5000
NOSI_FIT_TIMEZONE=Europe/Kyiv

<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-in token is bound to this device's Keystore key: never back it up or move it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
